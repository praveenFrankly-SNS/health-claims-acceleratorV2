# =============================================================================
# Supabase Credentials — for data population script
# =============================================================================
# Find these in your Supabase Dashboard -> Project Settings -> API

# Your Supabase project URL
SUPABASE_URL=https://nerwqbauracfinfvunul.supabase.co

# Your Supabase service_role key (NOT the anon/publisable key)
# Found in: Project Settings -> API -> service_role key
# WARNING: Keep this secret! Never commit to git.
SUPABASE_SERVICE_KEY=your_service_role_key_here


# =============================================================================
# Databricks Credentials — for running notebooks locally (optional)
# =============================================================================
# If running Databricks notebooks outside of a Databricks workspace,
# set these environment variables:
# DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
# DATABRICKS_TOKEN=your_personal_access_token


# =============================================================================
# Supabase JDBC Configuration — used by Databricks notebooks
# =============================================================================
# These values can be passed as notebook widgets instead
SUPABASE_USER=postgres
SUPABASE_PASSWORD=